{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "python3 -m pytest*": "allow",
      "{{PYTHON_NAME}} .agent-guard/trash.py *": "allow",
      "rm *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git push*": "deny",
      "sudo *": "deny",
      "npm publish*": "deny"
    }
  }
}
