{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash({{PYTHON_NAME}} .agent-guard/trash.py *)"
    ],
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(npm publish *)",
      "Edit(./.claude/**)",
      "Edit(./.agent-guard/**)",
      "Edit(./.git/**)",
      "Edit(./originals/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read",
        "hooks": [
          { "type": "command", "command": "{{GUARD}} --tool claude", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{CHECKPOINT}}", "timeout": 120 }
        ]
      }
    ]
  }
}
